<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clubhouse Club</title>
    <link href="/css/output.css" rel="stylesheet">
</head>

<body class="bg-slate-200">
    <%- include('./partials/navbar') %>
        <main>
            <div class="grid grid-cols-2 gap-4 mt-4 p-6">
                <% users.forEach((user)=> { %>
                    <div class="flex flex-col shadow-lg p-6 bg-white rounded-xl">
                        <h2 class="text-2xl font-bold">
                            <%= user.title %>
                        </h2>
                        <hr class="mt-3">
                        <p class="whitespace-pre-line">
                            <%= user.message %>
                        </p>
                        <% if(authenticatedUser?.membership_status==true){%>
                            <div class="flex mt-auto justify-between">
                                <p class="text-gray-800 ">Author: <%= user.first_name %>
                                        <%= user.last_name %>
                                </p>
                                <p class="text-gray-800">Date:
                                    <%= new Date(user.created_at).toLocaleDateString() %>
                                </p>
                                <% if(authenticatedUser.isadmin){ %>
                                    <form action="/auth/admin/delete/<%= user.message_id %>" method="POST">
                                        <button type="submit"
                                            onclick="return confirm('Are you sure you want to delete this message?');">
                                            Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                            <% } %>
                    </div>
                    <% }) %>
            </div>
        </main>
</body>

</html>