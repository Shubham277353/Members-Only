<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clubhouse Club</title>
    <link href="/css/output.css" rel="stylesheet">
</head>

<body>
    <nav class="flex justify-around ">
        <h2 class="text-3xl font-bold">Clubhouse Club</h2>
        <div class="flex justify-between">
            <% if (authenticatedUser) { %>
                <div class="flex gap-6">
                    <% if (!authenticatedUser.membership_status) { %>
                        <a href="/auth/membership">Become a Member</a>
                        <% } else{%>
                            <a href="/messages/create_new">Create Message</a>
                        <% } %>
                            <a href="/auth/logout">Logout</a>
                </div>
                <% } else { %>
                    <ul class="flex list-none gap-4">
                        <li><a href="/auth/login">Login</a></li>
                        <li><a href="/auth/sign-up">Sign up</a></li>
                    </ul>
                    <% } %>

        </div>
    </nav>
    <main>
        <div class="grid grid-cols-3 gap-4 mt-8">
            <div class="shadow-lg p-2">
                <% users.forEach((user)=> { %>

                    <h2 class="text-2xl font-bold">
                        <%= user.title %>
                    </h2>
                    <p class="mt-2">
                        <%= user.message %>
                    </p>
                    <% if(authenticatedUser?.membership_status==true){%>
                        <p class="text-gray-800">Author: <%= user.first_name %>
                                <%= user.last_name %>
                        </p>
                        <p class="text-gray-600 text-1xs">
                            <%= user.created_at %>
                        </p>
                        <% } %>
                            <% }) %>
            </div>
        </div>
    </main>
</body>

</html>