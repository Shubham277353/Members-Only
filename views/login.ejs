<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
        <link href="/css/output.css" rel="stylesheet">
</head>
<body>
    <%- include('./partials/navbar') %>
    <% if (message) { %>
    <p class="text-red-500"><%= message %></p>
    <% } %>
    <form action="/auth/login" method="post">
        <label for="email">Email:</label>
        <input class="border-2" type="email" id="email" name="email" placeholder="johndoe@example.com" value="<%= typeof data != 'undefined' ? data.email : '' %>" required>
        <label for="password">Password:</label>
        <input class="border-2" type="password" id="password" name="password" required>
        <button type="submit">Login</button> 
    </form>


</body>
</html>