
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club Membership</title>
    <link href="/css/output.css" rel="stylesheet">
</head>

<body class="min-h-screen bg-slate-100 text-slate-900">

    <%- include('./partials/navbar') %>

    <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6">

        <!-- Header -->
        <div class="mb-10 text-center">
            <h1 class="text-4xl font-bold tracking-tight text-slate-900">
                Clubhouse Club
            </h1>

            <p class="mt-3 text-slate-500">
                Become a member and unlock the full Clubhouse experience.
            </p>
        </div>

        <!-- Benefits -->
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

            <h2 class="text-2xl font-bold text-slate-900">
                Membership Benefits
            </h2>

            <p class="mt-2 text-sm text-slate-500">
                Membership comes with some extremely important privileges.
            </p>

            <ul class="mt-6 space-y-4">

                <li class="flex items-center gap-3 text-slate-700">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm text-white">
                        ✓
                    </span>
                    <span>Increase in societal status.</span>
                </li>

                <li class="flex items-center gap-3 text-slate-700">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm text-white">
                        ✓
                    </span>
                    <span>Increased Aura</span>
                </li>

                <li class="flex items-center gap-3 text-slate-700">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm text-white">
                        ✓
                    </span>
                    <span>Friends (probably)</span>
                </li>

                <li class="flex items-center gap-3 text-slate-700">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm text-white">
                        ✓
                    </span>
                    <span>Reveal who wrote which post</span>
                </li>

                <li class="flex items-center gap-3 text-slate-700">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm text-white">
                        ✓
                    </span>
                    <span>Write your own posts</span>
                </li>

            </ul>

        </section>

        <!-- Membership Form -->
        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

            <h2 class="text-2xl font-bold text-slate-900">
                Want to become a member?
            </h2>

            <p class="mt-2 text-sm leading-6 text-slate-500">
                To join the club, enter the Super Secret Club Passcode.
            </p>

            <form method="post" action="/auth/membership" class="mt-6">

                <label
                    for="passcode"
                    class="mb-2 block text-sm font-medium text-slate-700"
                >
                    Club Passcode
                </label>

                <div class="flex flex-col gap-3 sm:flex-row">

                    <input
                        type="password"
                        name="passcode"
                        id="passcode"
                        placeholder="Enter passcode"
                        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                    >

                    <button
                        type="submit"
                        class="rounded-lg bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2"
                    >
                        Join Club
                    </button>

                </div>

            </form>

        </section>

    </main>

</body>
</html>